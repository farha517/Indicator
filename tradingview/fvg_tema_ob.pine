// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
//@version=6
indicator("Breakaway FVG + TEMA 8/55 + Order Blocks", shorttitle = "FVG·TEMA·OB", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

// ════════════════════════════════════════════════════════════════════════════
// HOW IT WORKS
//  1. Range High / Range Low = the latest swing high / swing low (or a session range).
//  2. A candle CLOSES through the Range High (bullish) or Range Low (bearish).
//  3. The script finds the Fair Value Gap left by that impulse = SETUP ZONE and
//     places a limit order there with Stop-loss and Take-profit (default 1R).
//  4. Price comes back and taps the limit  ->  BUY / SELL arrow + alert.
//  5. TEMA 8 / 55 filter: longs only when TEMA 8 > TEMA 55, shorts only when below.
//  6. Every break of structure also marks an Order Block (last opposite candle
//     before the move). OBs extend right until price closes through them.
// ════════════════════════════════════════════════════════════════════════════

// ───────── Inputs
grpS = "Structure"
rangeMode = input.string("Swing pivots", "Range source", options = ["Swing pivots", "Session range"], group = grpS,
     tooltip = "Swing pivots: last confirmed swing high/low.\nSession range: high/low of the time window below.")
swingLen  = input.int(5, "Swing strength (candles each side)", minval = 1, group = grpS,
     tooltip = "A swing high needs this many lower highs on BOTH sides. Smaller = more (smaller) swings.")
sessWin   = input.session("0930-0945", "Session range window", group = grpS)
sessTz    = input.string("America/New_York", "Session timezone", group = grpS)
maxLook   = input.int(300, "Max candles to search back", minval = 20, maxval = 900, group = grpS)

grpT = "Trade"
entryMode = input.string("FVG edge", "Limit entry", options = ["FVG edge", "FVG 50%"], group = grpT,
     tooltip = "FVG edge: first touch of the gap. FVG 50%: middle of the gap.")
slMode    = input.string("Swing", "Stop-loss", options = ["Swing", "FVG"], group = grpT,
     tooltip = "Swing: beyond the low/high of the impulse leg. FVG: just beyond the far side of the gap.")
slTicks   = input.int(2, "Stop buffer (ticks)", minval = 0, group = grpT)
rr        = input.float(1.0, "Take-profit (R)", minval = 0.1, step = 0.25, group = grpT)
expiry    = input.int(30, "Cancel limit after N candles", minval = 1, group = grpT)

grpM = "TEMA filter"
temaFastLen = input.int(8, "TEMA fast", minval = 1, group = grpM)
temaSlowLen = input.int(55, "TEMA slow", minval = 2, group = grpM)
filterMode  = input.string("Trend", "Filter", options = ["Trend", "Recent cross", "Off"], group = grpM,
     tooltip = "Trend: TEMA fast must be above slow for longs (below for shorts).\nRecent cross: also needs a cross within the lookback.\nOff: FVG strategy only.")
crossLook   = input.int(20, "Recent cross lookback (candles)", minval = 1, group = grpM)
showTema    = input.bool(true, "Show TEMA lines", group = grpM)
showBg      = input.bool(true, "Trend background colour", group = grpM)

grpO = "Order blocks"
showOB   = input.bool(true, "Show order blocks", group = grpO)
obMax    = input.int(4, "Max active OBs per side", minval = 1, maxval = 20, group = grpO)
obSearch = input.int(10, "Candles to search for OB candle", minval = 1, maxval = 50, group = grpO)
obBullC  = input.color(color.new(#26a69a, 80), "Bullish OB", group = grpO)
obBearC  = input.color(color.new(#ef5350, 80), "Bearish OB", group = grpO)

grpV = "Display"
showLevels = input.bool(true, "Show Range High / Low", group = grpV)
showTable  = input.bool(true, "Show info panel", group = grpV)
winText    = input.string("WIN 🎉", "Take-profit label", group = grpV)
lossText   = input.string("SL", "Stop-loss label", group = grpV)

// ───────── Colours
cBull  = #26a69a
cBear  = #ef5350
cEntry = color.yellow

// ───────── TEMA
tema(src, len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    3 * e1 - 3 * e2 + e3

temaF     = tema(close, temaFastLen)
temaS     = tema(close, temaSlowLen)
warm      = bar_index >= temaSlowLen
bullTrend = temaF > temaS
rawBullX  = ta.crossover(temaF, temaS)
rawBearX  = ta.crossunder(temaF, temaS)
bullCross = warm and rawBullX
bearCross = warm and rawBearX
sinceBull = nz(ta.barssince(bullCross), 100000)
sinceBear = nz(ta.barssince(bearCross), 100000)

longOK  = filterMode == "Off" or (warm and bullTrend and (filterMode == "Trend" or sinceBull < crossLook))
shortOK = filterMode == "Off" or (warm and not bullTrend and (filterMode == "Trend" or sinceBear < crossLook))

// ───────── Range High / Range Low
var float rangeHi    = na
var int   rangeHiBar = na
var bool  hiUsed     = true
var float rangeLo    = na
var int   rangeLoBar = na
var bool  loUsed     = true

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

inSess = not na(time(timeframe.period, sessWin, sessTz))
var float sHi    = na
var float sLo    = na
var int   sHiBar = na
var int   sLoBar = na

if rangeMode == "Swing pivots"
    if not na(ph)
        rangeHi    := ph
        rangeHiBar := bar_index - swingLen
        hiUsed     := false
    if not na(pl)
        rangeLo    := pl
        rangeLoBar := bar_index - swingLen
        loUsed     := false
else
    if inSess and not inSess[1]
        sHi    := high
        sLo    := low
        sHiBar := bar_index
        sLoBar := bar_index
    else if inSess
        if high > sHi
            sHi    := high
            sHiBar := bar_index
        if low < sLo
            sLo    := low
            sLoBar := bar_index
    if not inSess and inSess[1]
        rangeHi    := sHi
        rangeHiBar := sHiBar
        hiUsed     := false
        rangeLo    := sLo
        rangeLoBar := sLoBar
        loUsed     := false

// ───────── Types
type Setup
    string side
    float  entry
    float  stop
    float  tp
    int    setupBar
    int    fillBar
    string status    // "pending" | "open" | "done" | "dead"
    box    zone
    line   entryLn
    line   slLn
    line   tpLn

type OB
    box   bx
    float top
    float bot
    int   created
    bool  touched

var Setup longS  = na
var Setup shortS = na
var array<OB> bullOBs = array.new<OB>()
var array<OB> bearOBs = array.new<OB>()

var int    winStreak = 0
var int    wins      = 0
var int    losses    = 0
var string dirTxt    = "---"

// ───────── Helpers
newSetup(string side, float entry, float stop, float tp, int fvgBar, float top, float bot) =>
    isLong = side == "long"
    zone = box.new(fvgBar, top, bar_index + 1, bot, border_color = isLong ? cBull : cBear, border_width = 2,
         bgcolor = color.new(isLong ? cBull : cBear, 70))
    el = line.new(bar_index, entry, bar_index + 1, entry, color = cEntry, width = 2)
    sl = line.new(bar_index, stop, bar_index + 1, stop, color = cBear, style = line.style_dotted, width = 2)
    tl = line.new(bar_index, tp, bar_index + 1, tp, color = cBull, style = line.style_dotted, width = 2)
    Setup.new(side, entry, stop, tp, bar_index, na, "pending", zone, el, sl, tl)

kill(Setup s) =>
    s.status := "dead"
    line.delete(s.entryLn)
    line.delete(s.slLn)
    line.delete(s.tpLn)
    box.set_bgcolor(s.zone, color.new(color.gray, 88))
    box.set_border_color(s.zone, color.new(color.gray, 60))
    box.set_right(s.zone, bar_index)

stretch(Setup s) =>
    box.set_right(s.zone, bar_index + 1)
    line.set_x2(s.entryLn, bar_index + 1)
    line.set_x2(s.slLn, bar_index + 1)
    line.set_x2(s.tpLn, bar_index + 1)

// Advances a setup by one closed candle -> [filled, won, lost, cancelled]
step(Setup s) =>
    bool filled = false
    bool won    = false
    bool lost   = false
    bool killed = false
    if not na(s)
        isLong = s.side == "long"
        if s.status == "open"
            if bar_index > s.fillBar
                hitSL = isLong ? low <= s.stop : high >= s.stop
                hitTP = isLong ? high >= s.tp : low <= s.tp
                if hitSL or hitTP
                    s.status := "done"
                    lost := hitSL     // stop and target in the same candle = loss (conservative)
                    won  := not hitSL
        else if s.status == "pending" and bar_index > s.setupBar
            tapped = isLong ? low <= s.entry : high >= s.entry
            if tapped
                s.status  := "open"
                s.fillBar := bar_index
                filled    := true
                if (isLong ? low <= s.stop : high >= s.stop)
                    s.status := "done"
                    lost     := true
            else if (isLong ? close < s.stop : close > s.stop) or bar_index - s.setupBar >= expiry
                killed := true
        if killed
            kill(s)
        else if s.status == "open" or s.status == "pending"
            stretch(s)
        if won
            label.new(bar_index, s.tp, winText, style = isLong ? label.style_label_down : label.style_label_up,
                 color = cBull, textcolor = color.white, size = size.small)
        if lost
            label.new(bar_index, s.stop, lossText, style = isLong ? label.style_label_up : label.style_label_down,
                 color = cBear, textcolor = color.white, size = size.small)
    [filled, won, lost, killed]

addOB(array<OB> arr, int off, bool bull) =>
    top = high[off]
    bot = low[off]
    bx = box.new(bar_index - off, top, bar_index + 1, bot, border_color = bull ? cBull : cBear,
         bgcolor = bull ? obBullC : obBearC, text = bull ? "Bull OB" : "Bear OB", text_size = size.tiny,
         text_color = bull ? cBull : cBear, text_halign = text.align_right)
    if not showOB
        box.delete(bx)
    arr.push(OB.new(bx, top, bot, bar_index, false))
    if arr.size() > obMax
        old = arr.shift()
        box.delete(old.bx)

// Extends OBs, removes broken ones -> true if price tapped an OB for the first time
updateOBs(array<OB> arr, bool bull) =>
    bool tapped = false
    n = arr.size()
    if n > 0
        for i = n - 1 to 0
            ob = arr.get(i)
            broken = bull ? close < ob.bot : close > ob.top
            if broken
                box.delete(ob.bx)
                arr.remove(i)
            else
                box.set_right(ob.bx, bar_index + 1)
                if not ob.touched and bar_index > ob.created and (bull ? low <= ob.top : high >= ob.bot)
                    ob.touched := true
                    tapped     := true
    tapped

fmt(float p) => str.tostring(p, format.mintick)

// ───────── Engine (runs once per CLOSED candle -> no repainting)
bool longSetup  = false
bool shortSetup = false
bool longFill   = false
bool shortFill  = false
bool tradeWin   = false
bool tradeLoss  = false
bool bullOBnew  = false
bool bearOBnew  = false
bool bullOBtap  = false
bool bearOBtap  = false

if barstate.isconfirmed
    // 1) Order blocks
    bullOBtap := updateOBs(bullOBs, true)
    bearOBtap := updateOBs(bearOBs, false)

    // 2) Existing setups / trades
    [lF, lW, lL, lK] = step(longS)
    [sF, sW, sL, sK] = step(shortS)
    longFill  := lF
    shortFill := sF
    tradeWin  := lW or sW
    tradeLoss := lL or sL
    if tradeWin
        wins      += 1
        winStreak += 1
    if tradeLoss
        losses    += 1
        winStreak := 0
    if longFill
        alert(syminfo.ticker + " 🟢 BUY filled @ " + fmt(longS.entry) + " | SL " + fmt(longS.stop) + " | TP " + fmt(longS.tp), alert.freq_once_per_bar)
    if shortFill
        alert(syminfo.ticker + " 🔴 SELL filled @ " + fmt(shortS.entry) + " | SL " + fmt(shortS.stop) + " | TP " + fmt(shortS.tp), alert.freq_once_per_bar)
    if lW or sW
        alert(syminfo.ticker + " ✅ Take-profit hit", alert.freq_once_per_bar)
    if lL or sL
        alert(syminfo.ticker + " ❌ Stop-loss hit", alert.freq_once_per_bar)

    // 3) Bullish break of the Range High
    if not hiUsed and not na(rangeHi) and close > rangeHi
        hiUsed := true
        span = math.min(bar_index - rangeHiBar, maxLook)
        int   legOff = 0
        float legLow = low
        for i = 0 to span
            if low[i] < legLow
                legLow := low[i]
                legOff := i
        // Bullish order block = last bearish candle at / before the leg low
        for j = legOff to math.min(legOff + obSearch, maxLook)
            if close[j] < open[j]
                addOB(bullOBs, j, true)
                bullOBnew := true
                break
        // Most recent bullish FVG in the impulse leg
        int fOff = na
        for k = 0 to legOff
            if low[k] > high[k + 2]
                fOff := k
                break
        busy = not na(longS) and longS.status == "open"
        if not na(fOff) and longOK and not busy
            top   = low[fOff]
            bot   = high[fOff + 2]
            entry = entryMode == "FVG edge" ? top : (top + bot) / 2
            stop  = (slMode == "Swing" ? legLow : bot) - slTicks * syminfo.mintick
            if entry > stop
                if not na(longS) and longS.status == "pending"
                    kill(longS)
                longS     := newSetup("long", entry, stop, entry + rr * (entry - stop), bar_index - fOff - 2, top, bot)
                longSetup := true
                dirTxt    := "Bullish"
                alert(syminfo.ticker + " Bullish setup: BUY LIMIT " + fmt(entry) + " | SL " + fmt(stop) + " | TP " + fmt(longS.tp), alert.freq_once_per_bar)

    // 4) Bearish break of the Range Low
    if not loUsed and not na(rangeLo) and close < rangeLo
        loUsed := true
        span = math.min(bar_index - rangeLoBar, maxLook)
        int   legOff  = 0
        float legHigh = high
        for i = 0 to span
            if high[i] > legHigh
                legHigh := high[i]
                legOff  := i
        // Bearish order block = last bullish candle at / before the leg high
        for j = legOff to math.min(legOff + obSearch, maxLook)
            if close[j] > open[j]
                addOB(bearOBs, j, false)
                bearOBnew := true
                break
        int fOff = na
        for k = 0 to legOff
            if high[k] < low[k + 2]
                fOff := k
                break
        busy = not na(shortS) and shortS.status == "open"
        if not na(fOff) and shortOK and not busy
            top   = low[fOff + 2]
            bot   = high[fOff]
            entry = entryMode == "FVG edge" ? bot : (top + bot) / 2
            stop  = (slMode == "Swing" ? legHigh : top) + slTicks * syminfo.mintick
            if stop > entry
                if not na(shortS) and shortS.status == "pending"
                    kill(shortS)
                shortS     := newSetup("short", entry, stop, entry - rr * (stop - entry), bar_index - fOff - 2, top, bot)
                shortSetup := true
                dirTxt     := "Bearish"
                alert(syminfo.ticker + " Bearish setup: SELL LIMIT " + fmt(entry) + " | SL " + fmt(stop) + " | TP " + fmt(shortS.tp), alert.freq_once_per_bar)

    if bullOBtap
        alert(syminfo.ticker + " Price tapped a bullish order block", alert.freq_once_per_bar)
    if bearOBtap
        alert(syminfo.ticker + " Price tapped a bearish order block", alert.freq_once_per_bar)
    if bullCross
        alert(syminfo.ticker + " TEMA " + str.tostring(temaFastLen) + " crossed ABOVE " + str.tostring(temaSlowLen), alert.freq_once_per_bar)
    if bearCross
        alert(syminfo.ticker + " TEMA " + str.tostring(temaFastLen) + " crossed BELOW " + str.tostring(temaSlowLen), alert.freq_once_per_bar)

// ───────── Range High / Low lines
var line hiLn = line.new(na, na, na, na, color = cBull, style = line.style_dotted, width = 2)
var line loLn = line.new(na, na, na, na, color = cBear, style = line.style_dotted, width = 2)
if showLevels and not na(rangeHi)
    line.set_xy1(hiLn, rangeHiBar, rangeHi)
    line.set_xy2(hiLn, bar_index + 1, rangeHi)
if showLevels and not na(rangeLo)
    line.set_xy1(loLn, rangeLoBar, rangeLo)
    line.set_xy2(loLn, bar_index + 1, rangeLo)

// ───────── Plots
plot(showTema ? temaF : na, "TEMA fast", color = #2962ff, linewidth = 2)
plot(showTema ? temaS : na, "TEMA slow", color = #ff9800, linewidth = 2)
plot(showTema and bullCross ? temaF : na, "TEMA bull cross", color = cBull, style = plot.style_circles, linewidth = 4)
plot(showTema and bearCross ? temaF : na, "TEMA bear cross", color = cBear, style = plot.style_circles, linewidth = 4)
bgcolor(showBg and warm ? (bullTrend ? color.new(cBull, 90) : color.new(cBear, 90)) : na, title = "Trend background")
plotshape(longFill, "BUY", shape.triangleup, location.belowbar, cBull, text = "BUY", textcolor = cBull, size = size.small)
plotshape(shortFill, "SELL", shape.triangledown, location.abovebar, cBear, text = "SELL", textcolor = cBear, size = size.small)

// ───────── Info panel
var table panel = table.new(position.top_right, 2, 6, bgcolor = color.new(#1e222d, 10), border_width = 1)
if showTable and barstate.islast
    curEntry = not na(longS) and (longS.status == "pending" or longS.status == "open") ? longS.entry :
         not na(shortS) and (shortS.status == "pending" or shortS.status == "open") ? shortS.entry : na
    total = wins + losses
    table.cell(panel, 0, 0, "Range High", text_color = cBull, text_halign = text.align_left)
    table.cell(panel, 1, 0, na(rangeHi) ? "---" : fmt(rangeHi), text_color = cBull)
    table.cell(panel, 0, 1, "Range Low", text_color = cBear, text_halign = text.align_left)
    table.cell(panel, 1, 1, na(rangeLo) ? "---" : fmt(rangeLo), text_color = cBear)
    table.cell(panel, 0, 2, "Direction", text_color = color.white, text_halign = text.align_left)
    table.cell(panel, 1, 2, dirTxt, text_color = dirTxt == "Bullish" ? cBull : dirTxt == "Bearish" ? cBear : color.white)
    table.cell(panel, 0, 3, "Entry Price", text_color = color.white, text_halign = text.align_left)
    table.cell(panel, 1, 3, na(curEntry) ? "---" : fmt(curEntry), text_color = cEntry)
    table.cell(panel, 0, 4, "Win Streak", text_color = color.yellow, text_halign = text.align_left)
    table.cell(panel, 1, 4, (winStreak > 0 ? str.repeat("🔥", math.min(winStreak, 5)) + " " : "") + str.tostring(winStreak), text_color = color.yellow)
    table.cell(panel, 0, 5, "W / L", text_color = color.white, text_halign = text.align_left)
    table.cell(panel, 1, 5, str.tostring(wins) + " / " + str.tostring(losses) + (total > 0 ? "  (" + str.tostring(math.round(100.0 * wins / total)) + "%)" : ""), text_color = color.white)

// ───────── Alert conditions (pick these in TradingView's "Create alert" dialog)
alertcondition(longSetup, "Bullish setup (buy limit placed)", "{{ticker}} bullish FVG setup on {{interval}}")
alertcondition(shortSetup, "Bearish setup (sell limit placed)", "{{ticker}} bearish FVG setup on {{interval}}")
alertcondition(longFill, "BUY filled", "{{ticker}} BUY limit filled near {{close}}")
alertcondition(shortFill, "SELL filled", "{{ticker}} SELL limit filled near {{close}}")
alertcondition(tradeWin, "Take-profit hit", "{{ticker}} take-profit hit")
alertcondition(tradeLoss, "Stop-loss hit", "{{ticker}} stop-loss hit")
alertcondition(bullCross, "TEMA bullish cross", "{{ticker}} TEMA fast crossed above slow")
alertcondition(bearCross, "TEMA bearish cross", "{{ticker}} TEMA fast crossed below slow")
alertcondition(bullOBtap, "Bullish OB tapped", "{{ticker}} price tapped a bullish order block")
alertcondition(bearOBtap, "Bearish OB tapped", "{{ticker}} price tapped a bearish order block")
